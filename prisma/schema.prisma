generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================
// ACCOUNTS (Cash/Bank)
// =====================
model Account {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("CASH") // CASH, BANK, DIGITAL_WALLET
  balance   Float    @default(0)
  color     String   @default("#6366f1")
  icon      String   @default("wallet")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions              Transaction[]
  recurringTransactions      RecurringTransaction[]
  investments                Investment[]
  investmentTransactions     InvestmentTransaction[]
  savingsGoals               SavingsGoal[]
}

// =====================
// CARDS (Credit/Debit)
// =====================
model Card {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("CREDIT") // CREDIT, DEBIT
  brand          String   @default("VISA")   // VISA, MASTERCARD, ELO, AMEX, HIPER
  lastFourDigits String
  creditLimit    Float    @default(0)
  currentBalance Float    @default(0)
  closingDay     Int      @default(1)        // day of month the statement closes
  dueDay         Int      @default(10)       // day of month payment is due
  color          String   @default("#8b5cf6")
  flag           String   @default("")       // optional flag name
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions          Transaction[]
  purchases             Purchase[]
  recurringTransactions  RecurringTransaction[]
  installmentPlans       InstallmentPlan[]
}

// =====================
// CATEGORIES
// =====================
model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("tag")
  type      String   @default("EXPENSE") // INCOME, EXPENSE
  color     String   @default("#6b7280")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions          Transaction[]
  purchases             Purchase[]
  budgetGoals           BudgetGoal[]
  recurringTransactions  RecurringTransaction[]
  investments           Investment[]
  installmentPlans       InstallmentPlan[]
  consortiums           Consortium[]
  monthlyBudgets        MonthlyBudget[]
}

// =====================
// TRANSACTIONS
// =====================
model Transaction {
  id          String   @id @default(cuid())
  type        String   // INCOME, EXPENSE, TRANSFER
  amount      Float
  description String
  date        DateTime @default(now())
  notes       String   @default("")

  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  accountId   String?
  account     Account?   @relation(fields: [accountId], references: [id])
  cardId      String?
  card        Card?      @relation(fields: [cardId], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// =====================
// PURCHASES (Card purchases with item detail)
// =====================
model Purchase {
  id          String   @id @default(cuid())
  merchant    String
  totalAmount Float
  date        DateTime @default(now())
  notes       String   @default("")
  installmentNumber Int @default(1) // 1 = one-time, >1 = installment plan
  installmentTotal  Int @default(1) // total installments

  cardId      String?
  card        Card?      @relation(fields: [cardId], references: [id])
  accountId   String?
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])

  items       PurchaseItem[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// =====================
// PURCHASE ITEMS
// =====================
model PurchaseItem {
  id          String   @id @default(cuid())
  name        String
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float

  purchaseId  String
  purchase    Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// =====================
// RECURRING TRANSACTIONS
// =====================
model RecurringTransaction {
  id          String    @id @default(cuid())
  description String
  amount      Float
  type        String    // INCOME, EXPENSE
  frequency   String    // WEEKLY, BIWEEKLY, MONTHLY, QUARTERLY, YEARLY
  nextDate    DateTime
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id])
  cardId      String?
  card        Card?     @relation(fields: [cardId], references: [id])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// =====================
// BUDGET GOALS
// =====================
model BudgetGoal {
  id            String    @id @default(cuid())
  name          String
  description   String    @default("")
  targetAmount  Float
  currentAmount Float     @default(0)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  startDate     DateTime  @default(now())
  endDate       DateTime?
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// =====================
// INVESTMENTS
// =====================
model Investment {
  id              String    @id @default(cuid())
  name            String
  type            String    @default("STOCK") // STOCK, BOND, FII, CDB, LCI, LCA, TESOURO, CRYPTO, ETF, OTHER
  description     String    @default("")
  currentBalance  Float     @default(0)
  investedAmount  Float     @default(0)
  yieldRate       Float     @default(0)      // annual yield %
  brokerage       String    @default("")      // brokerage name
  ticker          String    @default("")      // e.g. PETR4, VBVA11
  accountId       String?
  account         Account?  @relation(fields: [accountId], references: [id])
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transactions    InvestmentTransaction[]
}

// =====================
// INVESTMENT TRANSACTIONS
// =====================
model InvestmentTransaction {
  id            String     @id @default(cuid())
  type          String     // APORTE, DIVIDENDO, VENDA, REINVESTIMENTO, TAXA, BONUS
  amount        Float
  quantity      Float      @default(0)     // shares/units
  unitPrice     Float      @default(0)
  date          DateTime   @default(now())
  description   String     @default("")
  notes         String     @default("")

  investmentId  String
  investment    Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  accountId     String?
  account       Account?   @relation(fields: [accountId], references: [id])

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// =====================
// INSTALLMENT PLANS (Financiamentos / Parcelamentos)
// =====================
model InstallmentPlan {
  id                String    @id @default(cuid())
  description       String
  totalAmount       Float     // total financed amount
  installmentCount  Int       // total number of installments
  paidInstallments  Int       @default(0)
  monthlyValue      Float     // value per installment
  interestRate      Float     @default(0)    // monthly interest rate %
  startDate         DateTime  @default(now())
  nextPaymentDate   DateTime?
  type              String    @default("FINANCING") // FINANCING, CARD_INSTALLMENT, LOAN, PERSONAL, RENTAL
  status            String    @default("ACTIVE")   // ACTIVE, COMPLETED, CANCELLED, OVERDUE

  cardId            String?
  card              Card?      @relation(fields: [cardId], references: [id])
  accountId         String?
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  installments      Installment[]
}

// =====================
// INSTALLMENTS (Individual parcels)
// =====================
model Installment {
  id                String    @id @default(cuid())
  number            Int       // installment number (1-based)
  amount            Float
  dueDate           DateTime
  paidDate          DateTime?
  status            String    @default("PENDING") // PAID, PENDING, OVERDUE
  notes             String    @default("")

  installmentPlanId String
  installmentPlan   InstallmentPlan @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// =====================
// CONSORTIUM (Consórcios)
// =====================
model Consortium {
  id                String    @id @default(cuid())
  description       String    // e.g. "Honda Civic 2024"
  group             String    @default("")     // group identifier
  quota             String    @default("")     // quota number
  administrator     String    @default("")     // administrator company
  totalAmount       Float     // total value of the asset
  fundedAmount      Float     @default(0)      // amount already paid
  monthlyPayment    Float     // monthly installment value
  installmentCount  Int       // total months
  paidInstallments  Int       @default(0)
  startDate         DateTime  @default(now())
  endDate           DateTime?
  nextAssemblyDate  DateTime?
  assembliesAttended Int     @default(0)
  status            String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED, CONTEMPLATED

  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  accountId         String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  installments      ConsortiumInstallment[]
}

// =====================
// CONSORTIUM INSTALLMENTS
// =====================
model ConsortiumInstallment {
  id              String    @id @default(cuid())
  number          Int       // installment number
  amount          Float
  dueDate         DateTime
  paidDate        DateTime?
  status          String    @default("PENDING") // PAID, PENDING, OVERDUE
  notes           String    @default("")
  assemblyDate    DateTime? // if payment was discussed in assembly
  assemblyResult  String    @default("") // notes about assembly result

  consortiumId    String
  consortium      Consortium @relation(fields: [consortiumId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// =====================
// MONTHLY BUDGETS
// =====================
model MonthlyBudget {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount      Float    // budget limit for this category
  month       Int      // 1-12
  year        Int      // e.g. 2026
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, month, year])
}

// =====================
// SAVINGS GOALS (Caixinhas / Metas de Poupança)
// =====================
model SavingsGoal {
  id                String    @id @default(cuid())
  name              String
  description       String    @default("")
  type              String    @default("SAVINGS") // SAVINGS, PIGGY_BANK, CDI, INVESTMENT, EMERGENCY_FUND
  targetAmount      Float
  currentAmount     Float     @default(0)
  monthlyContribution Float    @default(0)
  yieldRate         Float     @default(0)      // annual yield % for CDI etc.
  startDate         DateTime  @default(now())
  targetDate        DateTime?
  accountId         String?
  account           Account?  @relation(fields: [accountId], references: [id])
  isCompleted       Boolean   @default(false)
  color             String    @default("#22c55e")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
